# Normalize all text to LF in repo
* text=auto eol=lf

# Common text files (explicit LF)
*.kt text eol=lf
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Windows scripts may need CRLF
*.bat text eol=crlf

# Binary files (never modify line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.jar binary
*.keystore binary
*.jks binary